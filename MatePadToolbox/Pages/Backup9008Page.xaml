<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MatePadToolbox.Pages.Backup9008Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:MatePadToolbox.Controls"
    mc:Ignorable="d">

    <StackPanel Spacing="16">
        <Grid>
            <TextBlock Text="9008备份/恢复" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <controls:TroubleshootButton FeatureKey="backup9008" FeatureName="9008备份/恢复"
                                         HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
                 Title="警告"
                 Message="本工具仅支持适配的设备使用！回读全分区与恢复刷机都需要在 9008 模式下执行，操作过程中请勿断开数据线。"/>

        <TextBlock Text="选择当前系统版本" FontWeight="SemiBold"/>
        <RadioButtons x:Name="OsVersionGroup" SelectedIndex="0">
            <RadioButton Content="鸿蒙2 - 鸿蒙3（通过 ADB 自动进入 9008）"/>
            <RadioButton Content="鸿蒙4（需工程线/短接进入 9008，或先降级）"/>
        </RadioButtons>

        <Pivot x:Name="ModePivot" SelectedIndex="0">
            <!-- ==================== 备份模式 ==================== -->
            <PivotItem Header="备份">
                <StackPanel Spacing="12" Padding="0,8,0,0">
                    <TextBlock TextWrapping="Wrap" Opacity="0.8" LineHeight="22"
                               Text="通过 9008 模式回读设备全部分区镜像，生成 images（分区镜像）、gpt_and_xml（分区表与 rawprogram XML）和 flash_all.bat（一键线刷脚本）。与原高通工具箱脚本一致：userdata、last_parti 等超大/特殊分区默认不回读。"/>

                    <TextBlock Text="保存目录" FontWeight="SemiBold"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SavePathBox" Grid.Column="0" PlaceholderText="选择备份保存目录"/>
                        <Button x:Name="BtnBrowse" Grid.Column="1" Content="浏览..." Click="BrowseFolder_Click" MinWidth="90"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnStart" Content="回读全分区" Click="StartBackup_Click"
                                Style="{StaticResource AccentButtonStyle}" MinWidth="140"/>
                        <Button x:Name="BtnCancel" Content="取消" Click="Cancel_Click" IsEnabled="False"/>
                        <Button Content="打开备份目录" Click="OpenBackupDir_Click"/>
                    </StackPanel>
                </StackPanel>
            </PivotItem>

            <!-- ==================== 恢复模式 ==================== -->
            <PivotItem Header="恢复">
                <StackPanel Spacing="12" Padding="0,8,0,0">
                    <TextBlock TextWrapping="Wrap" Opacity="0.8" LineHeight="22"
                               Text="选择一个备份目录，程序将把其中的全部分区镜像（images\rawprogram0-5.xml）与分区表补丁（gpt_and_xml\create\patch0-5.xml）依次刷入设备，用于故障恢复/救砖。点击恢复后需确认该备份是否来自本机，以决定是否刷入基带与指纹相关分区。"/>

                    <TextBlock Text="备份目录" FontWeight="SemiBold"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RestorePathBox" Grid.Column="0" PlaceholderText="选择备份目录（如 D:\平板\backup\4.0）"/>
                        <Button x:Name="BtnBrowseRestore" Grid.Column="1" Content="浏览..." Click="BrowseRestoreFolder_Click" MinWidth="90"/>
                    </Grid>

                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                             Title="基带指纹保护"
                             Message="恢复时将询问该备份是否来自本机：本机备份刷入全部镜像（含基带 modemst1/modemst2/fsg/fsc 与指纹 oeminfo/persist/frp/devinfo）；他人备份则跳过这些分区，避免基带丢失或指纹失效。"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnRestore" Content="开始恢复" Click="StartRestore_Click"
                                Style="{StaticResource AccentButtonStyle}" MinWidth="140"/>
                        <Button x:Name="BtnCancelRestore" Content="取消" Click="Cancel_Click" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </PivotItem>
        </Pivot>

        <controls:LogPanel x:Name="Log" Height="320"/>
    </StackPanel>
</Page>
