<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MatePadToolbox.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:MatePadToolbox.Controls"
    mc:Ignorable="d">

    <StackPanel Spacing="16">
        <TextBlock Text="华为高通芯片通用工具箱" FontSize="28" FontWeight="Bold"/>
        <TextBlock TextWrapping="Wrap" LineHeight="22" Opacity="0.8"
                   Text="面向华为高通芯片设备的通用刷机工具箱。处理器型号在侧边栏顶部的【CPU型号】下拉框中全局选择，解锁BL、9008备份、Root、刷机等都按所选型号执行。刷机解锁等操作存在风险，请确保已备份数据。"/>

        <InfoBar x:Name="ToolCheckBar" IsOpen="False" IsClosable="False"/>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="检查核心工具" Click="CheckTools_Click" Style="{StaticResource AccentButtonStyle}"/>
            <Button Content="打开程序根目录" Click="OpenBaseDir_Click"/>
        </StackPanel>

        <TextBlock Text="功能列表" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <Grid Padding="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="1" FontWeight="Bold"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="安装驱动程序"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="ADB 驱动与高通 9008（EDL）驱动" Opacity="0.7" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="2" FontWeight="Bold"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="9008备份/恢复"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="备份：回读全部分区镜像并生成 images/、gpt_and_xml/ 与 flash_all.bat；恢复：按备份刷回，他人备份自动屏蔽基带/指纹分区" Opacity="0.7" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="3" FontWeight="Bold"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="解锁BL"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="按侧边栏所选型号刷入 ABL 解锁镜像；支持鸿蒙2-3 与 鸿蒙4（工程线/降级后解锁）" Opacity="0.7" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="4" FontWeight="Bold"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="Root"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="APatch 方式（自动经 9008 提取/修补/刷入 boot，推荐）与 Magisk 方式（刷 ramdisk，不建议）；均可一键隐藏 Root" Opacity="0.7" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="5" FontWeight="Bold"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="优化模块"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="从 optimize_modules.json 读取模块，直链/网盘下载后经 ADB 一键刷入 Magisk / APatch" Opacity="0.7" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="6" FontWeight="Bold"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="下载第三方系统/底包"/>
                <TextBlock Grid.Row="5" Grid.Column="2" Text="从 Gitee 获取系统列表与底包下载链接（system_config.json 配置）" Opacity="0.7" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="7" FontWeight="Bold"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Text="刷入第三方系统"/>
                <TextBlock Grid.Row="6" Grid.Column="2" Text="Fastboot 模式 / 9008 模式：底包、去 AVB 校验、super.img、一键执行（9008 按所选型号）" Opacity="0.7" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="8" FontWeight="Bold"/>
                <TextBlock Grid.Row="7" Grid.Column="1" Text="高级刷机"/>
                <TextBlock Grid.Row="7" Grid.Column="2" Text="Fastboot 模式刷入任意分区镜像；9008 模式读取设备分区表后按分区刷入" Opacity="0.7" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="9" FontWeight="Bold"/>
                <TextBlock Grid.Row="8" Grid.Column="1" Text="刷官方系统(救砖)"/>
                <TextBlock Grid.Row="8" Grid.Column="2" Text="刷 UPDATE.APP，解包后递归刷入全部分区镜像（多个 super 分片自动合并）" Opacity="0.7" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="10" FontWeight="Bold"/>
                <TextBlock Grid.Row="9" Grid.Column="1" Text="降级系统/回锁BL"/>
                <TextBlock Grid.Row="9" Grid.Column="2" Text="旧版华为手机助手 + HiSuite Proxy + 修改系统时间" Opacity="0.7" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="11" FontWeight="Bold"/>
                <TextBlock Grid.Row="10" Grid.Column="1" Text="高级工具箱"/>
                <TextBlock Grid.Row="10" Grid.Column="2" Text="连接 9008 并发送引导（仅下发 firehose，不写镜像）、恢复出厂设置、重启到 Fastboot/9008/设备" Opacity="0.7" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="11" Grid.Column="0" Text="12" FontWeight="Bold"/>
                <TextBlock Grid.Row="11" Grid.Column="1" Text="分区解包/打包"/>
                <TextBlock Grid.Row="11" Grid.Column="2" Text="super 动态分区与 erofs / ext4 分区镜像的解包与打包" Opacity="0.7" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="12" Grid.Column="0" Text="13" FontWeight="Bold"/>
                <TextBlock Grid.Row="12" Grid.Column="1" Text="ADB工具集"/>
                <TextBlock Grid.Row="12" Grid.Column="2" Text="启动外部 adb 工具集，同时打开内置 ADB 命令行（工作目录为 tools）" Opacity="0.7" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="13" Grid.Column="0" Text="14" FontWeight="Bold"/>
                <TextBlock Grid.Row="13" Grid.Column="1" Text="设备管理器"/>
                <TextBlock Grid.Row="13" Grid.Column="2" Text="打开 Windows 设备管理器" Opacity="0.7" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <controls:LogPanel x:Name="Log" Height="160"/>
    </StackPanel>
</Page>
