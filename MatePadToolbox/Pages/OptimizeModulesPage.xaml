<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MatePadToolbox.Pages.OptimizeModulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:MatePadToolbox.Controls"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="0,0,0,12">
            <Grid>
                <TextBlock Text="优化模块" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                <controls:TroubleshootButton FeatureKey="optimize" FeatureName="优化模块"
                                             HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                     Title="提示"
                     Message="模块列表来自 modules 目录下的 optimize_modules.json，支持“直链下载”与“跳转网盘”两种方式。点击任意模块会弹出操作面板。一键刷入需要：已开启 USB 调试、驱动已正确安装、已关闭 Shamiko 模块。"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnRefresh" Content="在线更新模块列表" Click="RefreshModules_Click"/>
                <Button x:Name="BtnCancel" Content="取消" Click="Cancel_Click" IsEnabled="False"
                        ToolTipService.ToolTip="停止正在进行的下载或刷入操作"/>
                <TextBlock x:Name="ModuleCountText" VerticalAlignment="Center" Opacity="0.7"/>
            </StackPanel>

            <GridView x:Name="ModuleGrid" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="ModuleItem_Click"
                      Padding="0" Margin="0">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="200" Height="100" CornerRadius="8" Padding="14" Margin="4"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"
                                           MaxLines="2"/>
                                <TextBlock Text="{Binding File}" Opacity="0.55" FontSize="11" TextWrapping="Wrap"
                                           MaxLines="2"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <controls:LogPanel x:Name="Log" Height="200"/>
        </StackPanel>
    </ScrollViewer>
</Page>
